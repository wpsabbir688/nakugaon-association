# Copy to server/.env and client/.env (see README). Placeholders only — never commit real secrets.
# --- server/.env ---
MONGODB_URI=mongodb://127.0.0.1:27017/nakugaon?replicaSet=rs0
PORT=4001
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CLIENT_URL=http://localhost:5173
# Uploads: local (implemented) — set STORAGE_DRIVER=s3 only after implementing the S3 driver (see docs/DEPLOYMENT.md).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Email: no provider is configured. Password-reset emails are logged only until SMTP is configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nakugaon Association <no-reply@example.com>
# --- client/.env ---
VITE_API_URL=http://localhost:4001/api/v1
