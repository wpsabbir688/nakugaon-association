# Copy to server/.env and client/.env (see README). Placeholders only — never commit real secrets.
# --- server/.env ---
# PostgreSQL connection string. PRODUCTION: use the DIRECT (non-pooled)
# connection string — PgBouncer transaction-mode pooling breaks Prisma
# interactive transactions, which this app uses for every multi-write
# financial operation. Never use a pooled URL for DATABASE_URL here.
DATABASE_URL=postgresql://user:password@localhost:5432/nakugaon_dev
PORT=4001
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CLIENT_URL=http://localhost:5173
# Uploads: local (implemented) — set STORAGE_DRIVER=s3 only after implementing the S3 driver (see docs/DEPLOYMENT.md).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Email: no provider is configured. Password-reset emails are logged only until SMTP is configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nakugaon Association <no-reply@example.com>
# --- client/.env ---
VITE_API_URL=http://localhost:4001/api/v1
# --- tests ---
# Server tests use TEST_DATABASE_URL when set, otherwise a local Unix-socket
# URL (peer auth as the OS user). See docs/TESTING.md.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/nakugaon_test
